# macOS
.DS_Store

# Claude Code: track shared .claude/settings.json, ignore local overrides
.claude/settings.local.json
.claude/*.local.json

# Logs
*.log

# Temp / local files
*.tmp
*.bak
*.swp
nohup.out
*.pid

# Generated audit output (never commit)
reports/
**/reports/
*.html
*.pdf

# CSV reports (generated by your scripts)
*.csv

# MySQL / Postgres dumps (kept under dms/<engine>/ — global `0*.sql`
# was too broad and also caught hand-written init fixture files).
*.sql.gz
*.dump
dms/*/0*.sql

# Local sandbox / test scaffolding — never commit. The audit toolkit
# itself is the deliverable; one-off compose stacks, seed scripts,
# and personal fixtures stay on the developer's machine.
docker/
docker-compose*.yml
docker-compose*.yaml
**/fixture*.sql
**/_sandbox*.sql

# Credentials
.env
*.pem
*.key
*.crt

# IDE
.vscode/
.idea/
.dbeaver/
.project

# Python (if you later add scripts)
__pycache__/
*.pyc
