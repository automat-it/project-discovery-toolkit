# macOS
.DS_Store
.claude

# Logs
*.log

# Temp / local files
*.tmp
*.bak
*.swp
nohup.out
*.pid

# Generated audit output (never commit)
reports/
**/reports/
*.html
*.pdf

# CSV reports (generated by your scripts)
*.csv

# MySQL / Postgres dumps (kept under dms/<engine>/ — global `0*.sql`
# was too broad and also caught hand-written init fixture files).
*.sql.gz
*.dump
dms/*/0*.sql

# Credentials
.env
*.pem
*.key
*.crt

# IDE
.vscode/
.idea/
.dbeaver/
.project

# Python (if you later add scripts)
__pycache__/
*.pyc
